# Local learning credentials only. Replace the password in your private .env.
POSTGRES_USER=playground
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=playground

API_HOST_PORT=3100
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# Used by the API when run on the host; Compose sets redis:6379 internally.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
